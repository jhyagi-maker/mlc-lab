---
import '../styles/global.css';
import { getLab, url } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
}

const lab = await getLab();
const { title, description = lab.tagline } = Astro.props;
const pageTitle = title ? `${title} | ${lab.name}` : lab.name;

const nav = [
	{ href: 'research', label: '연구' },
	{ href: 'members', label: '구성원' },
	{ href: 'publications', label: '논문' },
	{ href: 'news', label: '소식' },
	{ href: 'contact', label: '연락처' },
	{ href: 'autolab/experiments', label: '실험실 연구진행' },
];
const current = Astro.url.pathname;
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="logo" href={url()}>
					<span class="logo-mark" aria-hidden="true"></span>
					<span>
						<strong>{lab.name}</strong>
						{lab.nameEn && <small>{lab.nameEn}</small>}
					</span>
				</a>
				<details class="menu">
					<summary aria-label="메뉴 열기">메뉴</summary>
					<nav>
						{nav.map((item) => (
							<a href={url(item.href)} aria-current={current.includes(`/${item.href.split('/')[0]}`) ? 'page' : undefined}>
								{item.label}
							</a>
						))}
					</nav>
				</details>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container">
				<strong>{lab.name}</strong>
				<p class="muted">
					{lab.affiliation}<br />
					{lab.contact.address}<br />
					<a href={`mailto:${lab.contact.email}`}>{lab.contact.email}</a>
				</p>
				<p class="muted small">© {new Date().getFullYear()} {lab.nameEn ?? lab.name}</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 68px;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--text);
		line-height: 1.25;
	}
	.logo:hover { text-decoration: none; }
	.logo small { display: block; color: var(--muted); font-size: 0.75rem; }
	.logo-mark {
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: linear-gradient(135deg, var(--brand), var(--accent));
		flex: none;
	}
	.menu summary {
		list-style: none;
		cursor: pointer;
		padding: 6px 14px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.9rem;
	}
	.menu summary::-webkit-details-marker { display: none; }
	.menu nav {
		position: absolute;
		right: 16px;
		top: 60px;
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 8px;
		min-width: 160px;
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.08);
	}
	.menu nav a { color: var(--text); padding: 8px 12px; border-radius: 8px; }
	.menu nav a:hover { background: var(--accent-soft); text-decoration: none; }
	.menu nav a[aria-current='page'] { color: var(--accent); font-weight: 700; }

	@media (min-width: 760px) {
		.menu summary { display: none; }
		.menu nav {
			position: static;
			flex-direction: row;
			gap: 4px;
			background: none;
			border: 0;
			padding: 0;
			box-shadow: none;
			min-width: 0;
		}
	}

	.site-footer {
		margin-top: 64px;
		padding: 40px 0;
		border-top: 1px solid var(--line);
		font-size: 0.92rem;
	}
	.small { font-size: 0.8rem; }
</style>

<script>
	// 데스크톱 화면에서는 메뉴가 항상 보이도록 열어 둡니다.
	const menu = document.querySelector<HTMLDetailsElement>('.menu');
	const mq = window.matchMedia('(min-width: 760px)');
	const sync = () => menu && (menu.open = mq.matches);
	sync();
	mq.addEventListener('change', sync);
</script>
