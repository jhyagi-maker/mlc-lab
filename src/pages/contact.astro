---
import Base from '../layouts/Base.astro';
import { getLab } from '../lib/site';

const lab = await getLab();
const { contact } = lab;
---

<Base title="연락처">
	<div class="container">
		<header class="page-head">
			<h1>연락처</h1>
			<p>{lab.affiliation}</p>
		</header>

		{lab.recruiting && lab.recruitingText && (
			<div class="card recruit">
				<span class="tag">학생 모집</span>
				<p>{lab.recruitingText}</p>
			</div>
		)}

		<dl class="card info">
			<dt>주소</dt>
			<dd>
				{contact.address}
				{contact.mapUrl && <><br /><a href={contact.mapUrl} target="_blank" rel="noopener">지도에서 보기 →</a></>}
			</dd>
			<dt>이메일</dt>
			<dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
			{contact.phone && (
				<>
					<dt>전화</dt>
					<dd><a href={`tel:${contact.phone}`}>{contact.phone}</a></dd>
				</>
			)}
		</dl>
	</div>
</Base>

<style>
	.recruit { margin-top: 32px; border-color: var(--accent); }
	.recruit p { margin: 8px 0 0; }
	.info {
		margin-top: 16px;
		display: grid;
		grid-template-columns: 72px 1fr;
		gap: 12px 16px;
	}
	.info dt { font-weight: 700; color: var(--brand); }
	.info dd { margin: 0; }
</style>
