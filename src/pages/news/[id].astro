---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getNews, url } from '../../lib/site';

export async function getStaticPaths() {
	const news = await getNews();
	return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title}>
	<article class="container">
		<header class="page-head">
			<p class="muted">{formatDate(entry.data.date)}</p>
			<h1>{entry.data.title}</h1>
		</header>
		<div class="prose"><Content /></div>
		<p class="back"><a href={url('news')}>← 소식 목록으로</a></p>
	</article>
</Base>

<style>
	.page-head p { margin-bottom: 8px; }
	.prose { margin-top: 24px; font-size: 1.05rem; }
	/* 본문에 <div class="gallery"> 로 감싼 사진들은 가로로 나란히 표시 */
	.prose :global(.gallery p) { display: flex; flex-wrap: wrap; gap: 10px; }
	.prose :global(.gallery img) { height: 220px; max-width: 100%; width: auto; object-fit: cover; border-radius: 10px; border: 1px solid var(--line); }
	.back { margin-top: 48px; }
</style>
