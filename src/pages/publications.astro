---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { getPublications } from '../lib/site';

const pubs = await getPublications();
const years = [...new Set(pubs.map((p) => p.year))];
---

<Base title="논문">
	<div class="container">
		<header class="page-head">
			<h1>논문</h1>
			<p>저널 · 학회 · 특허 실적 (총 {pubs.length}건)</p>
		</header>

		{years.map((year) => (
			<section class="year">
				<h2>{year}</h2>
				<ul>{pubs.filter((p) => p.year === year).map((pub) => <PubItem pub={pub} />)}</ul>
			</section>
		))}
	</div>
</Base>

<style>
	.year { margin-top: 32px; }
	.year h2 { font-size: 1.4rem; margin: 0 0 4px; }
	.year ul { padding: 0; margin: 0; }
</style>
